if SHIELD_PROSPECTOR_SCANNER_OLED

config ZMK_KEYBOARD_NAME
    default "Prospector"

config ZMK_DISPLAY
    default y

# I2C bus for the OLED
config I2C
    default y

# Monochrome LVGL: 1 bit per pixel
config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

# Custom status screen (mono scanner UI)
choice ZMK_DISPLAY_STATUS_SCREEN
    default ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
endchoice

# --- dongle_display widget options (from englmaxi/zmk-dongle-display) ---
# Defined here so the ported presentation code compiles unchanged. Enable the
# widgets used by the default layout; bongo_cat / wpm are added later.
config ZMK_DONGLE_DISPLAY_LAYER
    bool
    default y

config ZMK_DONGLE_DISPLAY_LAYER_NAME_SCROLL_WIDTH
    int
    default 50

config ZMK_DONGLE_DISPLAY_LAYER_TEXT_ALIGN
    string
    default "left"

config ZMK_DONGLE_DISPLAY_MODIFIERS
    bool
    default y

config ZMK_DONGLE_DISPLAY_MAC_MODIFIERS
    bool
    default y

config ZMK_DONGLE_DISPLAY_BONGO_CAT
    bool
    default y

config ZMK_DONGLE_DISPLAY_WPM
    bool
    default y

config ZMK_DONGLE_DISPLAY_WPM_DISABLED_LAYERS
    string
    default ""

endif
